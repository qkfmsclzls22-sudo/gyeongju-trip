# Never commit real secrets. Set each value in Vercel's protected environment settings.
NEXTAUTH_URL=https://www.gjtrip.co.kr
NEXTAUTH_SECRET=
DATABASE_URL=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# SDK v2 card payment uses API individual payment keys (not widget keys).
NEXT_PUBLIC_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
COMMERCE_ENABLED=false
COMMERCE_MODE=test
# Enable only after real-account testing and operating/privacy details are finalized.
COMMERCE_LIVE_APPROVED=false
# Comma-separated internal UUID member IDs, never names or email addresses.
COMMERCE_ADMIN_IDS=
